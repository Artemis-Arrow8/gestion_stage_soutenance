<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage SGSUS : fond noir et monogramme « SG » doré au
     centre, affiché le temps que Flutter dessine sa première image (évite
     le flash blanc à l'ouverture). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/sgsus_noir" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_demarrage" />
    </item>
</layer-list>
