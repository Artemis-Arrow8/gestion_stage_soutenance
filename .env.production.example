# ---------------------------------------------------------------------------
# Modèle de déploiement derrière un reverse proxy HTTPS.
# Copier vers .env sur le serveur, remplacer chaque secret et vérifier le nom
# de domaine, l'origine CORS et la configuration TLS avant le démarrage.
# Ce fichier est un exemple : ne jamais l'utiliser sans compléter les champs.
# ---------------------------------------------------------------------------

# Clé secrète Django aléatoire d'au moins 50 caractères ; garder hors du dépôt.
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters

# Obligatoirement False pour protéger les erreurs et informations internes.
DJANGO_DEBUG=False

# Noms d'hôtes DNS servis par ce backend, sans schéma ni chemin.
DJANGO_ALLOWED_HOSTS=sgsus.example.org

# Origines Web précises autorisées ; séparer plusieurs origines par des virgules.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.org

# Force HTTPS ; le reverse proxy doit rediriger le trafic HTTP entrant.
DJANGO_SECURE_SSL_REDIRECT=True

# Les cookies sensibles ne sont envoyés que sur une connexion HTTPS.
DJANGO_SECURE_COOKIES=True

# True seulement si le proxy TLS maîtrisé écrase X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=True

# Politique HSTS d'un an ; n'utiliser ce modèle qu'après validation complète
# du HTTPS et de tous les sous-domaines concernés.
DJANGO_SECURE_HSTS_SECONDS=31536000

# À activer uniquement si tous les sous-domaines utilisent également HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Préchargement HSTS optionnel ; le laisser désactivé sauf décision explicite.
DJANGO_SECURE_HSTS_PRELOAD=False

# L'API reste liée à la boucle locale ; le proxy HTTPS relaie vers ce port.
DJANGO_BIND_ADDRESS=127.0.0.1
DJANGO_PORT=8000

# Identifiants PostgreSQL privés ; remplacer le mot de passe par un secret long.
POSTGRES_DB=gestion_stage_soutenance
POSTGRES_USER=gestion_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Ces valeurs ne sont pas celles du port hôte : Compose force db:5432 au backend.
DB_HOST=db
DB_PORT=5432

# Durée du JWT d'accès, en minutes, à conserver courte.
JWT_ACCESS_TOKEN_MINUTES=5

# Durée maximale du jeton de renouvellement, en jours.
JWT_REFRESH_TOKEN_DAYS=1

# Rotation du jeton de renouvellement à chaque utilisation.
JWT_ROTATE_REFRESH_TOKENS=True

# Liste noire de l'ancien jeton après rotation.
JWT_BLACKLIST_AFTER_ROTATION=True

# Transport SMTP fourni par l'hébergeur ; remplacer l'hôte et les identifiants
# par les valeurs privées communiquées pour le domaine de production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.org
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=remplacer-par-le-compte-smtp
DJANGO_EMAIL_HOST_PASSWORD=replace-with-a-private-smtp-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL=noreply@sgsus.example.org

# Ne pas importer de données de démonstration ni définir ce mot de passe en prod.
SGSUS_DEMO_PASSWORD=

# Stockage persistant des documents ; ne pas placer ce répertoire dans l'image.
DJANGO_MEDIA_ROOT=/app/media
