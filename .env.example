# ---------------------------------------------------------------------------
# Modèle de développement local pour SGSUS.
# Copier ce fichier vers .env, puis remplacer les valeurs marquées À CHANGER.
# Ne jamais committer .env ; le modèle de production est .env.production.example.
# ---------------------------------------------------------------------------

# Clé cryptographique de Django : valeur de développement uniquement.
# Générer une vraie clé avec get_random_secret_key() avant tout déploiement.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Active les outils de développement. Toujours mettre False en production.
DJANGO_DEBUG=True

# Noms d'hôtes autorisés, séparés par des virgules et sans http:// ou https://.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines exactes autorisées à appeler l'API depuis un navigateur.
# Laisser vide si le frontend n'est pas une application Web servie séparément.
DJANGO_CORS_ALLOWED_ORIGINS=

# Redirige HTTP vers HTTPS ; garder False pour une démonstration locale HTTP.
DJANGO_SECURE_SSL_REDIRECT=False

# Protège les cookies de session et CSRF ; True uniquement si HTTPS est utilisé.
DJANGO_SECURE_COOKIES=False

# À activer uniquement derrière un proxy de confiance qui définit l'en-tête
# X-Forwarded-Proto à https et remplace toute valeur fournie par le client.
DJANGO_BEHIND_HTTPS_PROXY=False

# Durée HSTS en secondes ; 0 désactive HSTS pour le développement local.
DJANGO_SECURE_HSTS_SECONDS=0

# Exige HTTPS sur tous les sous-domaines ; ne pas activer sans les avoir vérifiés.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Demande le préchargement HSTS dans les navigateurs ; généralement laisser False.
DJANGO_SECURE_HSTS_PRELOAD=False

# Adresse d'écoute publiée par Docker Compose ; 127.0.0.1 évite l'accès LAN.
DJANGO_BIND_ADDRESS=127.0.0.1

# Port HTTP publié par Docker Compose sur la machine hôte.
DJANGO_PORT=8000

# Base PostgreSQL utilisée par Django et initialisée par le conteneur postgres.
POSTGRES_DB=gestion_stage_soutenance

# Compte PostgreSQL dédié à l'application, distinct du superutilisateur postgres.
POSTGRES_USER=gestion_user

# À CHANGER : secret PostgreSQL. Utiliser une valeur longue et aléatoire.
POSTGRES_PASSWORD=replace-with-a-local-password

# Hôte et port PostgreSQL vus par Django hors Docker.
# Dans Compose, DB_HOST et DB_PORT sont remplacés par db et 5432.
DB_HOST=localhost
DB_PORT=5432

# Durée de validité du JWT d'accès, en minutes (courte recommandée).
JWT_ACCESS_TOKEN_MINUTES=5

# Durée maximale du jeton de renouvellement, en jours.
JWT_REFRESH_TOKEN_DAYS=1

# Renouvelle le jeton de rafraîchissement à chaque utilisation.
JWT_ROTATE_REFRESH_TOKENS=True

# Révoque l'ancien jeton de rafraîchissement après sa rotation.
JWT_BLACKLIST_AFTER_ROTATION=True

# Backend d'e-mail local ; choisir un relais SMTP géré en production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Mot de passe facultatif des comptes seed de démonstration.
# Définir localement une phrase secrète de 12 caractères minimum ; ne pas
# stocker ce secret dans le dépôt ni le réutiliser pour un vrai compte.
SGSUS_DEMO_PASSWORD=

# Répertoire durable des documents déposés ; Compose le fixe à /app/media.
DJANGO_MEDIA_ROOT=
