@startuml mld
hide circle
skinparam linetype ortho

entity campaign {
  * id : serial <<PK>>
  --
  academic_year : varchar
  is_active : boolean
  created_at : timestamptz
}
entity student {
  * id : serial <<PK>>
  --
  student_number : varchar <<UNIQUE>>
  full_name : varchar
  email : varchar <<UNIQUE>>
}
entity auth_user {
  * id : serial <<PK>>
  --
  username : varchar <<UNIQUE>>
  password : varchar
  is_active : boolean
}
entity student_account {
  * id : bigserial <<PK>>
  --
  user_id : int <<FK, UNIQUE>>
  student_id : int <<FK, UNIQUE>>
}
entity internship_folder {
  * id : serial <<PK>>
  --
  student_id : int <<FK>>
  campaign_id : int <<FK>>
  company_name : varchar
  subject : text
  status : varchar
}
entity folder_supervisor {
  * id : bigserial <<PK>>
  --
  user_id : int <<FK>>
  folder_id : int <<FK>>
}
entity document_version {
  * id : serial <<PK>>
  --
  folder_id : int <<FK>>
  version_number : int
  file_path : varchar
}
entity review {
  * id : serial <<PK>>
  --
  document_version_id : int <<FK>>
  author_id : int <<FK>>
  decision : varchar
  comments : text
}
entity room {
  * id : serial <<PK>>
  --
  name : varchar <<UNIQUE>>
  capacity : int
  is_active : boolean
}
entity jury {
  * id : serial <<PK>>
  --
  name : varchar
  is_complete : boolean
}
entity jury_member {
  * id : serial <<PK>>
  --
  jury_id : int <<FK>>
  member_name : varchar
  role_in_jury : varchar
}
entity jury_member_account {
  * id : bigserial <<PK>>
  --
  user_id : int <<FK, UNIQUE>>
  jury_member_id : int <<FK, UNIQUE>>
}
entity defense {
  * id : serial <<PK>>
  --
  folder_id : int <<FK>>
  jury_id : int <<FK>>
  room_name : varchar
  slot_range : tstzrange
  status : varchar
}
entity assessment {
  * id : serial <<PK>>
  --
  defense_id : int <<FK>>
  report_grade : numeric(5,2)
  oral_grade : numeric(5,2)
  final_average : numeric(5,2)
  is_approved : boolean
}

auth_user ||--o| student_account
student ||--o| student_account
campaign ||--o{ internship_folder
student ||--o{ internship_folder
internship_folder ||--o{ folder_supervisor
auth_user ||--o{ folder_supervisor
internship_folder ||--o{ document_version
document_version ||--o{ review
auth_user |o--o{ review
jury ||--o{ jury_member
jury_member ||--o| jury_member_account
auth_user ||--o| jury_member_account
internship_folder ||--o{ defense
jury |o--o{ defense
defense ||--o| assessment
room ||..o{ defense : room_name
@enduml
