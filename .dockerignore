# Limiter le contexte Docker aux fichiers nécessaires et exclure données/secrets.
.git
.gitignore
.env
.env.*
**/.env
**/.env.*
**/**pycache**
**/*.py[cod]
**/*.sqlite3
**/.DS_Store
backend/.venv
backend/venv
**/.pytest_cache
**/media/
**/staticfiles/
backups/
frontend/
docs/
scripts/
.github/
.vscode/
**/key.properties
**/*.jks
**/*.keystore
frontend/.dart_tool
frontend/build
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
